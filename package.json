{
  "name": "idverse-technical-exam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test tests/api && playwright test tests/web --workers=1",
    "test:headed": "playwright test --headed --workers=1",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "test:smoke": "playwright test --grep @smoke --workers=1",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "test:web": "playwright test tests/web --workers=1",
    "test:api": "playwright test tests/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3"
  },
  "description": "Playwright + TypeScript web and API test automation — technical exam submission"
}
