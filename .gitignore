# Agent skill caches. Both directories are fully regenerated by the two install
# commands in docs/onboarding/new-workstation-setup.md §2 — never commit them.
# `.claude/skills/playwright-{ci,core,pom}` are symlinks into `.agents/skills/`.
.agents/
.claude/skills/

# playwright-cli runtime artifacts (snapshots, console logs) — but keep the
# shared browser config so every clone drives the same browser.
.playwright-cli/
.playwright/*
!.playwright/cli.config.json
